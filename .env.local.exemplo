# Credenciais do MERCHANT na Appmax.
# Copie este arquivo para  .env.local  e preencha.
# O .env.local fica fora do Git e fora do deploy — as credenciais
# nunca saem do seu PC por aqui.

APPMAX_CLIENT_ID=cole_aqui_o_client_id
APPMAX_CLIENT_SECRET=cole_aqui_o_client_secret

# sandbox = ambiente de teste, nao cobra ninguem.
# Trocar para "producao" so no dia do go-live.
APPMAX_ENV=sandbox

# Opcional por enquanto: id da instalacao do app na loja.
# Necessario para tokenizar o cartao pelo navegador (appmax.js).
APPMAX_EXTERNAL_ID=
